[modules]
# Project modules and their current status

[module.config]
name=Configuration Module
file=src/config.py
description=Manages application settings and environment variables
status=completed
dependencies=[]

[module.file_handler]
name=File Handler Module
file=src/file_handler.py
description=Handles input/output file operations and directory management
status=completed
dependencies=[config]

[module.ollama_client]
name=Ollama Client Module
file=src/ollama_client.py
description=Wrapper for Ollama API interactions
status=completed
dependencies=[config]

[module.image_analyzer]
name=Image Analyzer Module
file=src/image_analyzer.py
description=Performs AI-based image analysis using vision models
status=completed
dependencies=[ollama_client]

[module.cost_estimator]
name=Cost Estimator Module
file=src/cost_estimator.py
description=Calculates repair costs based on damage analysis
status=completed
dependencies=[image_analyzer]

[module.report_generator]
name=Report Generator Module
file=src/report_generator.py
description=Generates CSV reports from analysis results
status=completed
dependencies=[file_handler]

[module.main]
name=Main Module
file=src/main.py
description=Entry point for CLI application
status=completed
dependencies=[config, file_handler, image_analyzer, cost_estimator, report_generator]

[module.web_ui]
name=Web UI Module
file=src/web_ui.py
description=Streamlit-based web interface
status=completed
dependencies=[config, file_handler, image_analyzer, cost_estimator, report_generator]

